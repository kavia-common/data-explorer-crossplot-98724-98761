# Example environment configuration for OpenAI-compatible integration

# Primary API key variables (choose one)
# This will be used if no aiApiKey is found in localStorage.
REACT_APP_OPENAI_API_KEY=
# Some pipelines inject a double-prefixed variant; also supported by the app:
REACT_APP_REACT_APP_OPENAI_API_KEY=
# Generic alias for OpenAI-compatible providers (also supported):
REACT_APP_AI_API_KEY=

# Base URL and path for OpenAI-compatible Chat Completions
# Defaults to https://api.openai.com and /v1/chat/completions if not provided.
REACT_APP_OPENAI_BASE_URL=https://api.openai.com
REACT_APP_OPENAI_CHAT_PATH=/v1/chat/completions

# Alternate aliases for base URL (all are supported; use one if needed)
# Useful when pointing to a proxy or compatible provider.
REACT_APP_AI_BASE=
REACT_APP_REACT_APP_AI_BASE=

# Model selection (the app defaults to gpt-4o-mini if none is set)
REACT_APP_OPENAI_MODEL=gpt-4o-mini
# Alternate aliases for model name (also supported):
REACT_APP_AI_MODEL=
REACT_APP_REACT_APP_AI_MODEL=
