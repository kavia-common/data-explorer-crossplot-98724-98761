# Example environment variables for the Crossplot frontend

# Optional: Base URL for the dataset API (already supported by services/api.js)
# REACT_APP_API_BASE=https://api.synergies.ar

# Optional: OpenAI-compatible API key to enable LLM interpretation
# You may also set/store this in the browser via the UI; this env var is a fallback.
# REACT_APP_OPENAI_API_KEY=sk-********************************

# Optional: Model name for the OpenAI Chat Completions API
# REACT_APP_OPENAI_MODEL=gpt-4o-mini
