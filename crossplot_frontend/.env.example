# Frontend environment variables for AI endpoint (example)
# Do NOT commit real secrets. Copy to .env and fill in values.

# OpenAI-compatible base URL (without the /v1 suffix).
# Examples:
#   - OpenAI: https://api.openai.com
#   - Proxy:  https://your-proxy.example.com
REACT_APP_OPENAI_BASE_URL=
REACT_APP_AI_BASE=https://api.openai.com
# Some pipelines use this alias:
REACT_APP_REACT_APP_AI_BASE=

# Chat completions path. Defaults to /v1/chat/completions
# IMPORTANT: If your base URL already ends with /v1, set this to /chat/completions to avoid double /v1.
REACT_APP_OPENAI_CHAT_PATH=/v1/chat/completions

# Default AI model
REACT_APP_AI_MODEL=gpt-4o-mini
# Alias sometimes used:
REACT_APP_REACT_APP_AI_MODEL=

# API keys (set one; do not commit your real key)
REACT_APP_OPENAI_API_KEY=
REACT_APP_REACT_APP_OPENAI_API_KEY=
REACT_APP_AI_API_KEY=
